---
name: nadia
version: 0.1.0
description: A coding agent on a local model — batch CLI and interactive REPL.
---

# nadia

Two front-ends over one loop. `nadia run <task>` works headlessly in the current
directory; `nadia chat` opens a line-based session. The loop, streaming, retry and
schema derivation come from `std.agent`; the per-family tool dialect stays in the
rozum gateway. What lives here is what an application owns: tools, prompts, safety
policy, and the interface.

[AgentEndpoint, RunOptions, runAgent, AgentResult, AgentTool](std/agent.ssc)
[Sandbox, nadiaTools](tools.ssc)
[helpAll, helpOne, unknownCommand](commands.ssc)
[McpServerSpec, parseMcpConfig, selectServers, connectServer, isMcpTool, connectedLine, stdioRefusal](mcp.ssc)
[deriveCheck, cargoFloor, runCheck, repairPrompt, isHallucinatedCargoCheck, gateEnabled, gateRounds](gate.ssc)
[readFile, exists](std/fs.ssc)
[args, env, envOrElse, cwd, exit, readLine](std/os.ssc)

```scalascript
/** What the model is told before anything else.
  *
  * Deliberately short: a small local model follows five rules better than a page of
  * them, and every token here is re-sent on every step of every turn. */
def systemPrompt(root: String): String =
  "You are nadia, a coding agent working in " + root + ".\n" +
  "\n" +
  "Work by calling tools, not by describing what should be done. When the task needs " +
  "a file changed, change it; do not print the file and stop.\n" +
  "\n" +
  "Before you claim a task is finished, verify it: run the build, the test, or the " +
  "program with `bash` and read the output. If the command failed, the task is not " +
  "finished — fix it and run it again. Never report success you have not observed.\n" +
  "\n" +
  "Create a project IN that directory, not under it: `cargo init` in the workspace root, " +
  "never `cargo new <name>`, which makes a subdirectory the acceptance check cannot see.\n" +
  "\n" +
  "Every path you pass to a tool is RELATIVE to that directory: write `src/main.rs`, never " +
  root + "/src/main.rs and never the same path with its leading slash dropped. Repeating the " +
  "workspace path builds a copy of it INSIDE itself and the file lands where nobody is " +
  "looking — the run then reports success for work the person who asked cannot find.\n" +
  "\n" +
  "Read a file before editing it, and quote `old_string` exactly as it appears. Make " +
  "the smallest change that satisfies the task.\n" +
  "\n" +
  "When the task is genuinely done, reply with a short plain-text summary. That final " +
  "message ends the task, so do not send it while work remains."

/** `std.agent` appends `/v1/chat/completions` itself (`agent.ssc:361`), so what it wants
  * is the BARE origin. The environment hands us both spellings — `rozum launch` exports
  * `OPENAI_BASE_URL` with `/v1` and `ROZUM_GATEWAY_URL` without — so strip it rather than
  * make the caller know which variable they happened to set.
  *
  * This is the opposite of what the Rust twin does: `OpenAiHttpBackend` there takes the
  * base WITH `/v1`. Same URL, two conventions, and getting it backwards is a 404 with an
  * empty body — which is what it cost the first time. */
def bareOrigin(url: String): String =
  val t = if url.endsWith("/") then url.substring(0, url.length - 1) else url
  if t.endsWith("/v1") then t.substring(0, t.length - 3) else t

def defaultGateway(): String =
  env("OPENAI_BASE_URL") match
    case Some(u) => bareOrigin(u)
    case None =>
      env("ROZUM_GATEWAY_URL") match
        case Some(u) => bareOrigin(u)
        case None    => "http://127.0.0.1:8080"

val usage =
  "nadia — a coding agent on a local model\n" +
  "\n" +
  "USAGE:\n" +
  "    nadia run <task>   run one task headlessly in the current directory\n" +
  "    nadia chat         interactive session (default with no arguments)\n" +
  "    nadia mcp list     the configured MCP servers\n" +
  "    nadia help         this text\n" +
  "\n" +
  "OPTIONS:\n" +
  "    --mcp <NAME>       connect this MCP server's tools (repeatable)\n" +
  "    --mcp-all          connect every server in the config\n" +
  "    --mcp-config PATH  [default: ./.mcp.json]\n" +
  "\n" +
  "ENV:\n" +
  "    OPENAI_BASE_URL / ROZUM_GATEWAY_URL   where the gateway is\n" +
  "    NADIA_MODEL                           model id to ask it for\n" +
  "\n" +
  "MCP servers are opt-in per run: a config that merely exists adds no tools, because\n" +
  "every tool costs schema tokens in every request. Their tools are named\n" +
  "mcp__<server>__<tool> and run OUTSIDE the workspace jail.\n" +
  "\n" +
  "EXIT CODES (batch):  0 finished   1 budget exhausted   2 gateway failure"

/** One line per executed tool call — what it did, not the raw JSON of what came back. */
def renderOps(r: AgentResult): Unit =
  for op <- r.operations do
    val mark = if op.isError then "  ✗ " else "  ⏺ "
    println(mark + op.tool + " " + firstLine(op.argsJson))

def firstLine(s: String): String =
  val cut = if s.length > 96 then s.substring(0, 96) + "…" else s
  cut.replace("\n", " ")

def runOnce(sb: Sandbox, endpoint: AgentEndpoint, model: String, task: String, maxSteps: Int,
            extraTools: List[AgentTool]): AgentResult =
  runAgent(endpoint, model, systemPrompt(sb.root), task, nadiaTools(sb) ++ extraTools,
           RunOptions(temperature = 0.0, maxSteps = maxSteps))

// ─── MCP wiring (SPEC §2.1) ──────────────────────────────────────────────────

/** The flags this front-end parses. Everything else is a mode or a task word, as before. */
case class Flags(mcp: List[String], mcpAll: Boolean, mcpConfig: String, rest: List[String])

def parseFlags(argv: List[String]): Flags =
  def go(rest: List[String], f: Flags): Flags =
    rest match
      case Nil => f
      case a :: tail =>
        if a == "--mcp-all" then go(tail, Flags(f.mcp, true, f.mcpConfig, f.rest))
        else if a == "--mcp" then
          tail match
            case v :: more => go(more, Flags(f.mcp :+ v, f.mcpAll, f.mcpConfig, f.rest))
            case Nil       => f
        else if a == "--mcp-config" then
          tail match
            case v :: more => go(more, Flags(f.mcp, f.mcpAll, v, f.rest))
            case Nil       => f
        else go(tail, Flags(f.mcp, f.mcpAll, f.mcpConfig, f.rest :+ a))
  go(argv, Flags(List(), false, "", List()))

/** Where the config is: `--mcp-config`, else the workspace's own `.mcp.json`. */
def mcpConfigPath(flags: Flags, root: String): String =
  if flags.mcpConfig != "" then flags.mcpConfig else root + "/.mcp.json"

def loadServers(path: String): Either[String, List[McpServerSpec]] =
  if exists(path) then Right(parseMcpConfig(readFile(path)))
  else Left("no MCP config at " + path + " (pass --mcp-config)")

/** Connect what was asked for, or exit 2 naming the server that would not start: a run
  * that silently lost half its tools produces a confidently wrong answer (SPEC §2.1). */
def connectRequested(flags: Flags, root: String): List[AgentTool] =
  if flags.mcp.length == 0 && !flags.mcpAll then List()
  else
    loadServers(mcpConfigPath(flags, root)) match
      case Left(why) =>
        println("nadia: " + why)
        exit(2)
        List()
      case Right(all) =>
        selectServers(all, flags.mcp, flags.mcpAll) match
          case Left(why) =>
            println("nadia: " + why)
            exit(2)
            List()
          case Right(chosen) =>
            def go(rest: List[McpServerSpec], acc: List[AgentTool]): List[AgentTool] =
              rest match
                case Nil => acc
                case s :: tail =>
                  connectServer(s) match
                    case Left(why) =>
                      println("nadia: " + why)
                      exit(2)
                      acc
                    case Right(tools) =>
                      println(connectedLine(s.name, tools))
                      go(tail, acc ++ tools)
            go(chosen, List())

/** The check for this run: what the task makes checkable, else the workspace's floor, else
  * nothing. A derived cargo check for a workspace and a task that have nothing to do with Rust
  * is dropped — the model once invented `cargo run -- pong == gnop` for a chat message. */
def gateCheckFor(endpoint: AgentEndpoint, model: String, task: String, root: String): Option[String] =
  if !gateEnabled() then None
  else
    deriveCheck(endpoint, model, task) match
      case Some(c) => if isHallucinatedCargoCheck(c, root, task) then None else Some(c)
      case None    => cargoFloor(root)

/** `nadia mcp list` — what is configured, and why an entry cannot be connected. */
def mcpList(flags: Flags, root: String): Unit =
  val path = mcpConfigPath(flags, root)
  loadServers(path) match
    case Left(why) => println(why)
    case Right(all) =>
      println(path)
      if all.length == 0 then println("  (no servers configured)")
      for s <- all do
        stdioRefusal(s) match
          case Some(why) => println("  " + s.name + "  ✗ " + why)
          case None      => println("  " + s.name + "  " + s.command + " " + s.args.mkString(" "))

/** Is this line a request for help, and for which command? The four spellings a person
  * actually types, and only as the whole line — `help me refactor this` is a message for
  * the model (SPEC §4.2). Returns ("", "") for "not a help request". */
def helpRequest(line: String): (String, String) =
  val t = line.trim()
  val sp = t.indexOf(" ")
  val head = if sp < 0 then t else t.substring(0, sp)
  val rest = if sp < 0 then "" else t.substring(sp + 1).trim()
  val h = head.toLowerCase()
  if h == "help" || h == "?" || h == "/help" || h == "/?" then ("help", rest) else ("", "")

/** The interactive front-end. Line-based on purpose: it works over ssh, in a pipe and
  * inside tmux without a terminal-control layer, and what a coding agent's UI has to get
  * right is showing WHAT IT DID, not drawing panes.
  *
  * Each turn is independent: `std.agent` exposes no entry point that resumes an existing
  * transcript, so context does not yet carry across turns here. The Rust twin has one
  * (`run_agent_conversation`); the same addition is wanted upstream — see NAD-11. */
def repl(sb: Sandbox, endpoint: AgentEndpoint, model: String, maxSteps: Int,
         mcpTools: List[AgentTool]): Unit =
  val all = nadiaTools(sb) ++ mcpTools
  println("nadia · " + model + " · " + sb.root)
  println(all.length.toString + " tools · help for commands · ctrl-d to exit")
  var running = true
  while running do
    print("\n› ")
    readLine() match
      case None => running = false
      case Some(raw) =>
        val line = raw.trim()
        val (isHelp, which) = helpRequest(line)
        if line == "" then ()
        else if isHelp == "help" then
          if which == "" then println(helpAll())
          else
            helpOne(which) match
              case Some(text) => println(text)
              case None       => println(unknownCommand(which))
        else if line == "/quit" || line == "/exit" then running = false
        else if line == "/tools" then
          for t <- all do println("  " + t.name)
        else if line == "/mcp" then
          val names = all.map(t => t.name).filter(isMcpTool)
          if names.length == 0 then
            println("no MCP server connected — start nadia with --mcp <name> " +
                    "(`nadia mcp list` shows what is configured)")
          else
            println(names.length.toString + " MCP tool(s), OUTSIDE the workspace jail:")
            for n <- names do println("  " + n)
        else if line.startsWith("/") then
          println(unknownCommand(line))
        else
          val r = runOnce(sb, endpoint, model, line, maxSteps, mcpTools)
          renderOps(r)
          if r.text != "" then println("\n" + r.text)
          if r.stop != "Done" then println("[stopped: " + r.stop + "]")

val flags = parseFlags(args.toList)
val argv = flags.rest
val mode = if argv.length == 0 then "chat" else argv(0)
val root = cwd
val sb = Sandbox(root)
val model = envOrElse("NADIA_MODEL", "local")
val endpoint = AgentEndpoint(defaultGateway())
val maxSteps = 24

// `nadia help` is the same answer as `-h`. A user who guesses the word everybody guesses
// should not be told that their guess is an unknown mode (SPEC §4.2).
if mode == "-h" || mode == "--help" || mode == "help" || mode == "?" then
  println(usage)
else if mode == "mcp" then
  if argv.length < 2 || argv(1) != "list" then
    println("nadia mcp list\n\n" + usage)
    exit(2)
  else mcpList(flags, root)
else if mode == "chat" then
  repl(sb, endpoint, model, maxSteps, connectRequested(flags, root))
else if mode == "run" then
  if argv.length < 2 then
    println("nadia run needs a task\n\n" + usage)
    exit(2)
  else
    val task = argv.drop(1).mkString(" ")
    val mcpTools = connectRequested(flags, root)
    // What "done" means, decided BEFORE the run so the run cannot influence it (SPEC §3.1).
    val check = gateCheckFor(endpoint, model, task, sb.root)
    check match
      case Some(c) => println("nadia: acceptance check — " + c)
      case None    => ()
    var r = runOnce(sb, endpoint, model, task, maxSteps, mcpTools)
    var failedCheck = false
    var round = 0
    var repairing = true
    while repairing && round < gateRounds() do
      check match
        case None => repairing = false
        case Some(c) =>
          val (passed, output) = runCheck(c, sb.root)
          if passed then
            println("nadia: ✔ проверка прошла: " + c)
            repairing = false
          else if round + 1 >= gateRounds() then
            println("nadia: ✘ проверка НЕ прошла: " + c + "\n" + output)
            failedCheck = true
            repairing = false
          else
            println("nadia: check failed — repair round " + (round + 1).toString)
            r = runOnce(sb, endpoint, model, repairPrompt(c, output, sb.root), maxSteps, mcpTools)
            round = round + 1
    renderOps(r)
    println(r.text)
    // A run whose check FAILED did not finish, whatever the model says about it.
    if failedCheck then exit(1)
    // The three values std.agent can return (agent.ssc): Done / MaxSteps / Error.
    // Mapped onto the exit codes scripts/bench/agentic.sh already distinguishes, where
    // rc=2 means infrastructure rather than a model that gave up.
    if r.stop == "Done" then exit(0)
    else if r.stop == "Error" then exit(2)
    else exit(1)
else
  println("unknown mode `" + mode + "`\n\n" + usage)
  exit(2)
```
